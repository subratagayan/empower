        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nflowchart LR\n\n%% ===================================================\n%% 1. SOURCE SYSTEMS\n%% ===================================================\nsubgraph SRC[\&quot;1. ENTERPRISE SOURCE SYSTEMS\&quot;]\ndirection TB\n    BANK[\&quot;Banking&lt;br/&gt;Oracle DB | On-Prem&lt;br/&gt;B1001, Savings = $85K\&quot;]\n    RET[\&quot;401k Recordkeeping&lt;br/&gt;SQL Server | On-Prem&lt;br/&gt;R551, Restricted Data\&quot;]\n    WEALTH[\&quot;Wealth Management&lt;br/&gt;Aurora PostgreSQL | AWS&lt;br/&gt;W901, Investments\&quot;]\n    MORT[\&quot;Mortgage&lt;br/&gt;RDS PostgreSQL | AWS&lt;br/&gt;M221, Loan Status\&quot;]\n    CRM[\&quot;Enterprise CRM&lt;br/&gt;Interactions and Appointments\&quot;]\n    CONSENT[\&quot;Consent Platform&lt;br/&gt;Marketing Opt-in and Purpose\&quot;]\nend\n\n%% ===================================================\n%% 2. DATA INTEGRATION AND CUSTOMER 360\n%% ===================================================\nsubgraph DATA[\&quot;2. AWS INTEGRATION + CUSTOMER 360\&quot;]\ndirection TB\n    DX[\&quot;AWS Direct Connect&lt;br/&gt;VPN Failover\&quot;]\n    DMS[\&quot;AWS DMS&lt;br/&gt;Initial Load + CDC\&quot;]\n    RAW[(\&quot;Amazon S3 Bronze&lt;br/&gt;Raw Records + CDC History\&quot;)]\n    GLUE[\&quot;AWS Glue / Spark&lt;br/&gt;Validation and Standardization\&quot;]\n    SILVER[(\&quot;S3 Iceberg Silver&lt;br/&gt;Standardized Customer Entities\&quot;)]\n    MATCH[\&quot;AWS Entity Resolution&lt;br/&gt;Deterministic / Probabilistic Match\&quot;]\n    MDM[(\&quot;Enterprise MDM | Aurora&lt;br/&gt;Crosswalk + Golden Identity&lt;br/&gt;B1001/W901/R551/M221 = CUST-123\&quot;)]\n    GOLD[(\&quot;S3 Iceberg Gold&lt;br/&gt;Governed Customer 360&lt;br/&gt;CUST-123 + Approved Attributes\&quot;)]\nend\n\n%% ===================================================\n%% 3. ML AND CENTRALISED DECISIONING\n%% ===================================================\nsubgraph INTEL[\&quot;3. AWS ANALYTICS + CENTRAL DECISIONING\&quot;]\ndirection TB\n    FEATURE[\&quot;AWS Glue / Spark&lt;br/&gt;Approved Feature Engineering\&quot;]\n    ML[\&quot;Amazon SageMaker AI&lt;br/&gt;Homebuyer Propensity = 0.87\&quot;]\n    POLICY[\&quot;Policy / Eligibility Service&lt;br/&gt;Consent, Rules, Suppression\&quot;]\n    ENGINE[\&quot;Central Decision Engine&lt;br/&gt;ECS Fargate&lt;br/&gt;Recommendation + Reason Codes\&quot;]\n    LEDGER[(\&quot;Aurora PostgreSQL&lt;br/&gt;Decision Ledger&lt;br/&gt;DEC-5001 + Model/Rule Versions\&quot;)]\n    CAMPAIGN[\&quot;UC1 - MARKETING&lt;br/&gt;Enterprise Campaign Platform&lt;br/&gt;Send Mortgage Consultation Offer\&quot;]\nend\n\n%% ===================================================\n%% 4. LOW LATENCY ONLINE SERVING\n%% ===================================================\nsubgraph SERVE[\&quot;4. AWS ONLINE SERVING + EXPERIENCE APIS\&quot;]\ndirection TB\n    PUB[\&quot;Profile Publisher&lt;br/&gt;Incremental / Event-Driven Upserts\&quot;]\n    DYNAMO[(\&quot;Amazon DynamoDB&lt;br/&gt;Customer Profile Read Model&lt;br/&gt;PK = CUST-123\&quot;)]\n    PROFILE[\&quot;Profile Service&lt;br/&gt;ECS Fargate\&quot;]\n    DECAPI[\&quot;Decision Retrieval Service&lt;br/&gt;ECS Fargate\&quot;]\n    JOURNEY[\&quot;Journey Service&lt;br/&gt;ECS Fargate\&quot;]\n    KNOW[\&quot;Versioned Product / FAQ Service&lt;br/&gt;Approved Mortgage Guidance\&quot;]\n    LIVE[\&quot;Mortgage Product API&lt;br/&gt;Live Pricing / Loan Status\&quot;]\n    API[\&quot;Amazon API Gateway + ECS&lt;br/&gt;Shared Customer Experience API&lt;br/&gt;SSO / JWT + Authorization\&quot;]\n    BUS[\&quot;Amazon EventBridge + SQS&lt;br/&gt;Journey and Change Events\&quot;]\nend\n\n%% ===================================================\n%% 5. CUSTOMER CHANNELS\n%% ===================================================\nsubgraph CHANNEL[\&quot;5. CUSTOMER CHANNELS - FOUR USE CASES\&quot;]\ndirection TB\n    WEB[\&quot;UC2 - WEBSITE&lt;br/&gt;Customer Portal&lt;br/&gt;View Mortgage Recommendation\&quot;]\n    CALL[\&quot;UC3 - CONTACT CENTER&lt;br/&gt;Amazon Connect + Agent CRM&lt;br/&gt;View Decision + Prior Activity\&quot;]\n    ADVISOR[\&quot;UC4 - IN-PERSON ADVISOR&lt;br/&gt;CRM / Advisor Portal&lt;br/&gt;View Decision + Full Journey\&quot;]\nend\n\n%% ===================================================\n%% 6. GOVERNANCE\n%% ===================================================\nGOV[\&quot;CROSS-CUTTING SECURITY / GOVERNANCE&lt;br/&gt;Lake Formation | IAM/KMS | Verified Permissions&lt;br/&gt;Consent | PII Controls | CloudWatch | Audit\&quot;]\n\n%% ===================================================\n%% SOURCE INGESTION\n%% ===================================================\nBANK --&gt;|\&quot;Banking CDC\&quot;| DX\nRET --&gt;|\&quot;Retirement CDC\&quot;| DX\nDX --&gt; DMS\nWEALTH --&gt;|\&quot;Wealth CDC\&quot;| DMS\nMORT --&gt;|\&quot;Mortgage CDC\&quot;| DMS\n\nDMS --&gt;|\&quot;01 - Source records + changes\&quot;| RAW\nRAW --&gt;|\&quot;02 - ETL\&quot;| GLUE\nGLUE --&gt;|\&quot;03 - Standardized records\&quot;| SILVER\n\n%% ===================================================\n%% ENTERPRISE IDENTITY / CUSTOMER 360\n%% ===================================================\nSILVER --&gt;|\&quot;04 - Match attributes\&quot;| MATCH\nMATCH --&gt;|\&quot;05 - Candidate matches\&quot;| MDM\nSILVER --&gt;|\&quot;06 - Business attributes\&quot;| GOLD\nMDM --&gt;|\&quot;07 - Enterprise Customer ID\&quot;| GOLD\n\n%% ===================================================\n%% PROPENSITY AND DECISIONING\n%% ===================================================\nGOLD --&gt;|\&quot;08 - Approved customer features\&quot;| FEATURE\nFEATURE --&gt;|\&quot;09 - Feature vectors\&quot;| ML\nML --&gt;|\&quot;10 - Propensity score 0.87\&quot;| ENGINE\n\nCONSENT --&gt;|\&quot;Current permission + purpose\&quot;| POLICY\nPOLICY --&gt;|\&quot;11 - Eligibility policy\&quot;| ENGINE\n\nENGINE --&gt;|\&quot;12 - DEC-5001 + explanation\&quot;| LEDGER\nENGINE --&gt;|\&quot;13 - Approved marketing audience\&quot;| CAMPAIGN\n\n%% ===================================================\n%% ONLINE PROFILE PUBLISHING\n%% ===================================================\nGOLD --&gt;|\&quot;14 - Approved profile attributes\&quot;| PUB\nMDM --&gt;|\&quot;Enterprise ID mapping\&quot;| PUB\nPUB --&gt;|\&quot;15 - Upsert by CUST-123\&quot;| DYNAMO\nDYNAMO --&gt;|\&quot;16 - Profile lookup\&quot;| PROFILE\n\nLEDGER --&gt;|\&quot;17 - Current versioned decision\&quot;| DECAPI\n\n%% ===================================================\n%% SHARED EXPERIENCE API\n%% ===================================================\nPROFILE --&gt;|\&quot;Profile response\&quot;| API\nDECAPI --&gt;|\&quot;DEC-5001 + reason codes\&quot;| API\nJOURNEY &lt;--&gt;|\&quot;Journey context\&quot;| API\nKNOW --&gt;|\&quot;Approved guidance\&quot;| API\nLIVE --&gt;|\&quot;Current pricing / loan status\&quot;| API\nMORT &lt;--&gt;|\&quot;Authoritative live lookup\&quot;| LIVE\n\n%% ===================================================\n%% UC1, UC2, UC3, UC4 JOURNEY\n%% ===================================================\nCAMPAIGN -.-&gt;|\&quot;UC1: Email / SMS, customer clicks\&quot;| WEB\nWEB &lt;--&gt;|\&quot;UC2: HTTPS - profile + DEC-5001\&quot;| API\nWEB -.-&gt;|\&quot;Customer later calls\&quot;| CALL\nCALL &lt;--&gt;|\&quot;UC3: HTTPS - same decision + history\&quot;| API\nCALL -.-&gt;|\&quot;Customer schedules meeting\&quot;| ADVISOR\nADVISOR &lt;--&gt;|\&quot;UC4: HTTPS - same decision + journey\&quot;| API\n\n%% ===================================================\n%% INTERACTION PERSISTENCE AND FEEDBACK\n%% ===================================================\nJOURNEY &lt;--&gt;|\&quot;Read / write CRM interactions\&quot;| CRM\nJOURNEY --&gt;|\&quot;18 - Persist then publish events\&quot;| BUS\nBUS -.-&gt;|\&quot;19 - Interaction analytics feed\&quot;| RAW\nBUS -.-&gt;|\&quot;20 - Refresh profile when needed\&quot;| PUB\nBUS -.-&gt;|\&quot;21 - Re-evaluate / invalidate\&quot;| ENGINE\nCONSENT -.-&gt;|\&quot;Consent changes\&quot;| BUS\n\n%% ===================================================\n%% GOVERNANCE CONTROLS\n%% ===================================================\nGOV -.-&gt; GOLD\nGOV -.-&gt; ENGINE\nGOV -.-&gt; API\n\n%% ===================================================\n%% STYLING\n%% ===================================================\nclassDef source fill:#e8f0ff,stroke:#4778bd,color:#153a66\nclassDef data fill:#e5f3ed,stroke:#488b69,color:#20523b\nclassDef intel fill:#fff1d9,stroke:#b78329,color:#68440b\nclassDef serving fill:#f0e9fb,stroke:#8669b2,color:#433063\nclassDef channel fill:#dcefff,stroke:#2675a8,color:#153e60\nclassDef primary fill:#ffe3bd,stroke:#b96c13,stroke-width:3px,color:#573700\nclassDef governance fill:#f1f1f1,stroke:#888,stroke-dasharray:5 5,color:#333\n\nclass BANK,RET,WEALTH,MORT,CRM,CONSENT source\nclass DX,DMS,RAW,GLUE,SILVER,MATCH,MDM,GOLD data\nclass FEATURE,ML,POLICY,LEDGER intel\nclass ENGINE primary\nclass CAMPAIGN,WEB,CALL,ADVISOR channel\nclass PUB,DYNAMO,PROFILE,DECAPI,JOURNEY,KNOW,LIVE,BUS serving\nclass API primary\nclass GOV governance\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="1XTRUlJnUHy8JRM9P6gd-71">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
