        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nflowchart TB\n    subgraph SOURCES[\&quot;1. ENTERPRISE SOURCE SYSTEMS\&quot;]\n        direction LR\n        B[\&quot;Banking&lt;br/&gt;Oracle - On Prem\&quot;]\n        W[\&quot;Wealth&lt;br/&gt;Aurora PostgreSQL - AWS\&quot;]\n        R[\&quot;401k&lt;br/&gt;SQL Server - On Prem\&quot;]\n        M[\&quot;Mortgage&lt;br/&gt;RDS PostgreSQL - AWS\&quot;]\n    end\n\n    subgraph PLATFORM[\&quot;2. AWS DATA PLATFORM - CUSTOMER 360\&quot;]\n        direction TB\n        DMS[\&quot;AWS DMS&lt;br/&gt;CDC + Initial Load\&quot;]\n        RAW[(\&quot;S3 Bronze&lt;br/&gt;Raw + CDC History\&quot;)]\n        GLUE[\&quot;AWS Glue / Spark&lt;br/&gt;Standardize and Validate\&quot;]\n        MATCH[\&quot;AWS Entity Resolution&lt;br/&gt;Identity Matching\&quot;]\n        MDM[(\&quot;Enterprise MDM&lt;br/&gt;Customer ID Crosswalk\&quot;)]\n        SILVER[(\&quot;S3 Iceberg Silver&lt;br/&gt;Harmonized Customer Data\&quot;)]\n        GOLD[(\&quot;S3 Iceberg Gold&lt;br/&gt;Approved Customer 360\&quot;)]\n        PUBLISH[\&quot;Profile Publisher&lt;br/&gt;CDC / Events\&quot;]\n    end\n\n    subgraph INTELLIGENCE[\&quot;3. ANALYTICS AND DECISIONING\&quot;]\n        direction TB\n        FEAT[\&quot;Feature Engineering&lt;br/&gt;Glue / Spark\&quot;]\n        ML[\&quot;SageMaker&lt;br/&gt;Homebuyer Propensity\&quot;]\n        CONSENT[\&quot;Consent + Eligibility&lt;br/&gt;Policy Service\&quot;]\n        DECISION[\&quot;Central Decision Service&lt;br/&gt;ECS Fargate\&quot;]\n        LEDGER[(\&quot;Aurora PostgreSQL&lt;br/&gt;Decision Ledger + Reasons\&quot;)]\n        CAMPAIGN[\&quot;Marketing Platform&lt;br/&gt;Campaign Activation\&quot;]\n    end\n\n    subgraph ONLINE[\&quot;4. ONLINE CUSTOMER EXPERIENCE\&quot;]\n        direction TB\n        PROFILE[(\&quot;DynamoDB&lt;br/&gt;Customer Profile Read Model\&quot;)]\n        API[\&quot;Customer Experience API&lt;br/&gt;API Gateway + ECS\&quot;]\n        PS[\&quot;