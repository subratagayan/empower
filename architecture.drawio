uot;| LIVE\n\n    PS --&gt;|\&quot;Read profile\&quot;| PROFILE\n    DS --&gt;|\&quot;Retrieve current decision\&quot;| LEDGER\n    JS &lt;--&gt;|\&quot;Read / write interactions\&quot;| CRM\n\n    JS --&gt;|\&quot;18. Publish journey events\&quot;| BUS\n    BUS --&gt;|\&quot;19. Analytical feedback\&quot;| RAW\n    BUS --&gt;|\&quot;20. Profile refresh\&quot;| PUBLISH\n    BUS --&gt;|\&quot;21. Reevaluate / invalidate\&quot;| DECISION\n\n    classDef storage fill:#e8f1ff,stroke:#3975af,color:#153956\n    classDef process fill:#e9f5eb,stroke:#43834b,color:#20452a\n    classDef important fill:#fff1d9,stroke:#c18a2b,color:#694809\n    classDef channel fill:#efe9fa,stroke:#8667b4,color:#40305e\n\n    class RAW,MDM,SILVER,GOLD,LEDGER,PROFILE,CRM storage\n    class DMS,GLUE,MATCH,FEAT,ML,PUBLISH,PS,DS,JS,BUS process\n    class DECISION,CONSENT,API important\n    class WEB,CALL,ADVISOR,CAMPAIGN channel\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="1XTRUlJnUHy8JRM9P6gd-1">
